{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "java: build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "javac -d target/classes -sourcepath src/main/java src/main/java/com/inventory/**/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [
                "$javac"
            ]
        }
    ]
}
